# Dev-only secrets template. Copy to .env (gitignored) and adjust:
#   cp .env.example .env
# Real secrets live in Vault (commit 23); nothing here is used in the cluster.

# Postgres (docker-compose.dev.yml)
POSTGRES_DB=booking
POSTGRES_USER=booking
POSTGRES_PASSWORD=booking-dev-only
POSTGRES_PORT=5432

# App (used from commit 3 on). Host is "postgres" inside compose,
# "localhost" when running the app directly on your machine.
DATABASE_URL=postgresql://booking:booking-dev-only@localhost:5432/booking

# Admin token for /admin endpoints (commit 9)
ADMIN_TOKEN=dev-admin-token-change-me
